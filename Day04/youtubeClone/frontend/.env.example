# For production, set VITE_API_BASE_URL to the full Render API URL, e.g.
# https://your-service.onrender.com/api/v1. Rebuild/redeploy after changing it.
# Development uses the local backend, which accepts localhost:3000 outside production.
# Restart Vite after changing these values.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_BASE_URL=/api/v1
VITE_FRONTEND_PORT=3000
